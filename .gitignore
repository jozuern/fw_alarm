# ============================================================================
#  Secrets NIEMALS committen!  config.h enthält WLAN-Passwort und Bark-Keys.
# ============================================================================
#  Bewusst mit Muster: auch Sicherungskopien (config.h.bak, config.h~, ...)
#  enthalten die Geheimnisse. Die Vorlagen bleiben per !-Ausnahme drin.
boss925_alarm_bark/config.h*
config.h*
nas_dashboard/config.php*
!boss925_alarm_bark/config.example.h
!nas_dashboard/config.example.php

# PlatformIO Build-Artefakte
.pio/
.pioenvs/
.piolibdeps/

# Arduino IDE Build-Ordner
build/
*.bin
*.elf
*.hex

# Synology-Dashboard: lokale Geheimnisse und Laufzeitdaten
# (Laufzeitdateien heißen *.php mit Guard-Zeile, damit Nginx sie nie ausliefert)
nas_dashboard/config.php
nas_dashboard/data/*.json
nas_dashboard/data/*.tmp
nas_dashboard/data/*.lock
nas_dashboard/data/*.log
nas_dashboard/data/*.php

# Außen-Wächter: die echte Konfiguration (Token + Bark-Key) lebt nur auf der VM
cloud_watcher/*.conf

# Persönliche Empfänger-Onboarding-Anleitung (enthält Name/Kontakt des Betreibers)
bark-anleitung.html
Bark-Anleitung-iPhone.pdf

# Editor / OS (inkl. Sicherungs-/Swap-Dateien, die Geheimnisse enthalten können)
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.orig

# Lokale Logdateien (z.B. debug.log vom seriellen Mitlesen)
*.log
