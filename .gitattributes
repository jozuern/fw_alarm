# Dateien für die Linux-VM des Außen-Wächters: immer LF (ein CR am
# Zeilenende macht das Bash-Skript und die systemd-Units unbrauchbar).
cloud_watcher/*.sh text eol=lf
cloud_watcher/*.service text eol=lf
cloud_watcher/*.timer text eol=lf
cloud_watcher/*.conf.example text eol=lf

# Vendor-Bibliotheken: Bytes unverändert lassen (Prüfsumme der Bundle-Datei).
nas_dashboard/assets/vendor/* -text


# Dateien für die Oracle-VM (server/) und die Brücke auf dem NAS (nas_bridge/):
# immer LF - sie laufen unter Linux/DSM (Bash, systemd, Nginx, PHP).
server/** text eol=lf
nas_bridge/** text eol=lf

# Go-Fassung: Quelltexte, Werkzeuge und Workflow immer LF (gofmt verlangt es,
# die Skripte laufen unter Bash). Ebenso jede Text-Datei, die das Programm
# einbettet (nas_dashboard/webassets.go): Die Bytes bestimmen ?v= und ETag und
# müssen auf PC und GitHub gleich sein. Eingebettete Bilder und
# assets/vendor/ bleiben bytegenau (-text, unten bzw. oben).
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
tools/*.sh text eol=lf
.github/** text eol=lf
internal/**/templates/** text eol=lf
nas_dashboard/assets/app/** text eol=lf
nas_dashboard/assets/app.css text eol=lf
nas_dashboard/assets/favicon.svg text eol=lf
nas_dashboard/manifest.json text eol=lf

# Bytes unverändert (zuletzt, damit es auch für *.go darin gilt): mitgelieferte
# Module, Vergleichsdateien der Tests, eingebettete Bilder.
vendor/** -text
**/testdata/** -text
tests/backend/fixtures/** -text
nas_dashboard/assets/**/*.png -text
